# AI Studio -demoympäristön (server.ts) ympäristömuuttujat.
# Tuotannon Synology NAS -asetukset: hummapp/.env.example

# JWT-allekirjoitusavain (vähintään 32 merkkiä). Jos puuttuu, käytetään satunnaista
# käynnistyskohtaista avainta, jolloin kirjautumiset vanhenevat uudelleenkäynnistyksessä.
SECRET_KEY=""

# Demon pääkäyttäjän salasana (vähintään 12 merkkiä). Jos puuttuu, sovellus luo
# satunnaisen salasanan ja tulostaa sen kerran palvelimen lokiin.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Leikkeen rajaus NFC-leimauksen ympäriltä (sekuntia)
VIDEO_SECONDS_BEFORE=5
VIDEO_SECONDS_AFTER=5

# Julkinen videoiden suoratoisto hummapp.fi-sivulla (videoissa näkyy taluttaja -> oletuksena pois)
PUBLIC_VIDEO_STREAM=false
# Julkaistaanko hevosten muistiinpanot julkisessa rajapinnassa (voivat sisältää terveysmerkintöjä)
PUBLIC_INCLUDE_NOTES=false

# APP_URL: AI Studio injektoi palvelun osoitteen automaattisesti.
APP_URL="MY_APP_URL"
