# ==============================================================================
# HummAPP Pilottijärjestelmä - Ympäristömuuttujat (.env)
# Kopioi tämä tiedosto nimelle .env: cp .env.example .env
# Muokkaa arvot vastaamaan Synology NAS -ympäristöäsi.
# ==============================================================================

# --- Sovelluksen yleisasetukset ---
APP_NAME=HummAPP
APP_ENV=production
APP_PORT=8000
APP_HOST=0.0.0.0

# Turva-avain JWT-tokeneille ja istunnoille.
# Luo vahva satunnainen avain esim. komennolla: openssl rand -hex 32
SECRET_KEY=vaihda-tama-salaisuus-openssl-rand-hex-32-arvolla-tuotantoon

# Tokenin voimassaoloaika minuutteina (oletus 43200 min = 30 päivää tallikäyttöön)
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Sallitut CORS-alkuperät pilkulla erotettuna (esim. https://hummapp.oma-talli.synology.me,http://localhost:8000)
ALLOWED_ORIGINS=*

# Ensimmäisen käynnistyksen automaattinen pääkäyttäjä (admin)
# Jos admin-käyttäjää ei ole tietokannassa, se luodaan näillä tiedoilla
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Tallipäällikkö2026!

# --- Tietokanta ---
# Polku SQLite-tietokantatiedostoon kontin sisällä (yhdistetty NAS-hakemistoon ./data)
DATABASE_PATH=/data/hummapp.db

# --- Hakemistopolut kontin sisällä ---
# Videoiden tallennushakemisto (kontti kirjoittaa tänne leikatut klipit)
VIDEO_OUTPUT_PATH=/videos

# Kameratallenteiden lähdehakemisto (liitetty vain luku -tilassa :ro NASin valvontakamerakansiosta)
CAMERA_SOURCE_PATH=/camera

# Kameran aikavyöhyke aikaleimojen täsmäämiseen
CAMERA_TIMEZONE=Europe/Helsinki

# Videoleikkauksen ajastukset (sekuntia ennen ja jälkeen NFC-luvun)
# Oletus: 10s ennen, 40s jälkeen -> kokonaiskesto n. 50s
VIDEO_SECONDS_BEFORE=10
VIDEO_SECONDS_AFTER=40

# Kameratallenteen odotus ja uudelleenyritykset:
# Kuinka monta sekuntia odotetaan ennen uutta tarkistusta (tallenne saattaa valmistua viiveellä)
VIDEO_RETRY_INTERVAL_SECONDS=5
# Maksimimäärä uudelleenyrityksiä (12 * 5s = 60 sekuntia odotusta)
VIDEO_MAX_RETRIES=12

# Hylättyjen videoiden turva-aika päivinä ennen mahdollista ylläpidon poistoa
VIDEO_REJECTED_RETENTION_DAYS=30

# Mock-kameran generointi testausta varten, jos oikeita kameratallenteita ei vielä ole
# Aseta 'true' kun testataan ilman oikeaa kameraa, jolloin FFmpeg luo testisignaalivideon
ENABLE_MOCK_CAMERA_FALLBACK=true

# --- Juomismittaus: VAIN ANTERO ---
# Hankkeessa vain Anterolla on juoma-automaatti. Määritä nimi ja ulkoisen laitteen ID.
DRINKING_HORSE_NAME=Antero
WATER_EXTERNAL_ID=WATER-METER-ANTERO-01
WATER_API_URL=https://api.mock-water-service.local/v1/measurements
WATER_API_KEY=mock-water-api-key-here
# Mittausdatan hakuajastin minuutteina (APScheduler)
WATER_FETCH_INTERVAL_MINUTES=15
# Käytetäänkö Mock-palvelua (true = simuloidut realistiset mittaukset ilman ulkoista verkkoa)
WATER_USE_MOCK=true

# --- Talli-ilman olosuhdemittaukset ---
AIR_API_URL=https://api.mock-air-service.local/v1/readings
AIR_API_KEY=mock-air-api-key-here
# Ilmanlaatudatan hakuajastin minuutteina (APScheduler)
AIR_FETCH_INTERVAL_MINUTES=10
# Käytetäänkö Mock-palvelua (true = simuloidut lämpötila-, kosteus-, ammoniakki-, CO2- ja PM-lukemat)
AIR_USE_MOCK=true

# --- Lokitus ja järjestelmä ---
LOG_LEVEL=INFO
LOG_FILE=/logs/hummapp.log
