# ==============================================================================
# HummAPP Pilottijärjestelmä - Ympäristömuuttujat (.env)
# Kopioi: cp .env.example .env  ja täytä vähintään SECRET_KEY ja ADMIN_PASSWORD.
# Sovellus EI käynnisty esimerkkiarvoilla tai tunnetuilla oletussalasanoilla.
# ==============================================================================

# --- Sovelluksen yleisasetukset ---
APP_NAME=HummAPP
APP_ENV=production
# Isäntäkoneen portti (compose.yaml ohjaa sen kontin porttiin 8000)
APP_PORT=8000
# Aikavyöhyke, jonka mukaan "tänään" ja vuorokausisummat lasketaan
APP_TIMEZONE=Europe/Helsinki

# --- Turvallisuus (PAKOLLISET) ---
# Luo: openssl rand -hex 32
SECRET_KEY=
# Ensimmäisen käynnistyksen pääkäyttäjä. Vähintään 12 merkkiä.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Tokenin voimassaoloaika minuutteina (43200 = 30 päivää tallipuhelimelle)
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Ulkoisen videosoittimen latauslinkin voimassaolo minuutteina
VIDEO_LINK_EXPIRE_MINUTES=10
# true, kun palvelu on HTTPS-reverse proxyn takana (eväste lähetetään vain HTTPS:llä)
COOKIE_SECURE=false
# CORS: tyhjä = pois päältä. Julkiselle sivustolle esim. https://hummapp.fi
ALLOWED_ORIGINS=

# --- Tietokanta ---
DATABASE_PATH=/data/hummapp.db

# --- Hakemistopolut kontin sisällä ---
VIDEO_OUTPUT_PATH=/videos
CAMERA_SOURCE_PATH=/camera

# Kameran tiedostonimien aikaleimojen aikavyöhyke (Synology tallentaa yleensä paikallisaikaan).
# Jos kamera nimeää tiedostot UTC-ajassa, aseta CAMERA_TIMEZONE=UTC.
CAMERA_TIMEZONE=Europe/Helsinki
# Kameran yksittäisen tallennetiedoston maksimipituus sekunteina
CAMERA_FILE_MAX_DURATION_SECONDS=3600

# Videoleikkeen rajaus NFC-leimauksen ympäriltä (sekuntia).
# Oletus: 5 s ennen + 13 s jälkeen leimauksen (yhteensä 18 s).
VIDEO_SECONDS_BEFORE=5
VIDEO_SECONDS_AFTER=13

# Kameratallenteen odotus: kamera kirjoittaa tiedoston valmiiksi vasta pätkän lopussa.
# Odotusaika yhteensä = VIDEO_MAX_RETRIES * VIDEO_RETRY_INTERVAL_SECONDS.
# Aseta odotus vähintään kameran tallennepätkän pituiseksi (esim. 5 min pätkät -> 30 * 12 s).
VIDEO_RETRY_INTERVAL_SECONDS=5
VIDEO_MAX_RETRIES=12

# Hylättyjen videoiden säilytys päivinä; tämän jälkeen yöllinen siivous poistaa ne (0 = ei poisteta)
VIDEO_REJECTED_RETENTION_DAYS=30

# Varoitus lokiin, jos puhelimen kello poikkeaa palvelimesta enemmän kuin tämä (sekuntia)
NFC_CLOCK_SKEW_WARNING_SECONDS=2

# VAIN TESTAUKSEEN: puuttuva kameratallenne korvataan testisignaalivideolla (merkitään TESTIVIDEO)
ENABLE_MOCK_CAMERA_FALLBACK=false

# VAIN TESTAUKSEEN: luo esimerkkihevonen Valo ja esimerkkitagit 04A31B92C56F80 (Antero) ja 04E24589F10123 (Valo)
SEED_DEMO_DATA=false

# Julkaistaanko hevosten muistiinpanot julkisessa /api/public/overview -rajapinnassa
# (muistiinpanot voivat sisältää terveysmerkintöjä)
PUBLIC_INCLUDE_NOTES=false

# --- Juomismittaus: VAIN ANTERO ---
DRINKING_HORSE_NAME=Antero
WATER_EXTERNAL_ID=WATER-METER-ANTERO-01
# Tuotantopalvelun osoite ja avain (käytetään, kun oikea provider toteutetaan)
WATER_API_URL=
WATER_API_KEY=
WATER_FETCH_INTERVAL_MINUTES=15
WATER_USE_MOCK=true

# --- Talli-ilman olosuhdemittaukset ---
AIR_API_URL=
AIR_API_KEY=
AIR_FETCH_INTERVAL_MINUTES=10
AIR_USE_MOCK=true

# --- Lokitus ---
LOG_LEVEL=INFO
LOG_FILE=/logs/hummapp.log
